# AquaGuru Environment Variables Example

# Flask Secret Key
SECRET_KEY=your-secret-key-change-in-production

# Database Engine: 'auto' (recommended), 'mysql', or 'sqlite'
DB_ENGINE=auto

# Option 1: Cloud MySQL URL (e.g. from TiDB, Aiven, Railway, Render External DB)
# DATABASE_URL=mysql://username:password@host:3306/aquaguru

# Option 2: Individual MySQL Parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aquaguru
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SSL_MODE=

